<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ElementsShell.Desktop.ViewModels"
        xmlns:models="using:ElementsShell.Desktop.Models"
        xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1540" d:DesignHeight="960"
        x:Class="ElementsShell.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1540"
        Height="960"
        MinWidth="1280"
        MinHeight="820"
        Background="#07111F"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.surface">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#13233A" Offset="0" />
                    <GradientStop Color="#0D1728" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.sidebarPanel">
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0B1E36" Offset="0" />
                    <GradientStop Color="#091421" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#12243B" />
            <Setter Property="Foreground" Value="#EEF4FF" />
            <Setter Property="BorderBrush" Value="#223A59" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Button.primaryAction">
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0F7BFF" />
            <Setter Property="BorderBrush" Value="#0F7BFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.secondaryAction">
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Foreground" Value="#EEF4FF" />
            <Setter Property="Background" Value="#1A2E49" />
            <Setter Property="BorderBrush" Value="#2A486F" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9CB2CB" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#143052" />
        </Style>
        <Style Selector="TextBlock.badgeText">
            <Setter Property="Foreground" Value="#8FD3FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.glassPanel">
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Background" Value="#E6101824" />
            <Setter Property="BorderBrush" Value="#27405D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="28" />
        </Style>
        <Style Selector="Border.stepCard">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#0C1828" />
            <Setter Property="BorderBrush" Value="#213854" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="Border.heroCard">
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="BorderBrush" Value="#30557E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="26" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#122945" Offset="0" />
                    <GradientStop Color="#0C1828" Offset="0.65" />
                    <GradientStop Color="#12111A" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.recentCard">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#0C1828" />
            <Setter Property="BorderBrush" Value="#213854" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinWidth" Value="220" />
        </Style>
        <Style Selector="Border.chromeCard">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="#101C2D" />
            <Setter Property="BorderBrush" Value="#244668" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="#67E8F9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid>
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="460" Height="460" Canvas.Left="-140" Canvas.Top="-110" Fill="#1B0F7BFF" />
            <Ellipse Width="360" Height="360" Canvas.Right="80" Canvas.Top="70" Fill="#15D7263D" />
            <Ellipse Width="320" Height="320" Canvas.Right="260" Canvas.Bottom="-120" Fill="#150FB884" />
        </Canvas>
        <Grid ColumnDefinitions="340,*" Margin="22">
            <Border Classes="sidebarPanel" Margin="0,0,20,0">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <StackPanel Spacing="10">
                        <Border CornerRadius="18" Padding="14" Background="#D7263D" Width="82">
                            <TextBlock Text="ES" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Elements Shell" FontSize="28" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Professional desktop workspace for AvePoint Elements operations." TextWrapping="Wrap" Classes="muted" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,26,0,20" Padding="16" CornerRadius="18" Background="#12243B" BorderBrush="#244668" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Session" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding ConnectionBadge}" Foreground="#67E8F9" FontWeight="Bold" />
                            <TextBlock Text="{Binding Environment}" Foreground="#EEF4FF" />
                            <TextBlock Text="{Binding TenantLabel}" Classes="muted" />
                            <Button Classes="secondaryAction" Command="{Binding StartOnboardingCommand}" Content="Open Onboarding" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Spacing="10">
                        <ItemsControl ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:NavigationItem">
                                    <Button Classes="nav"
                                            Margin="0,0,0,10"
                                            Command="{Binding $parent[Window].DataContext.SelectSectionCommand}"
                                            CommandParameter="{Binding Title}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                            <Border Width="44" Height="44" CornerRadius="14" Background="#0F7BFF">
                                                <TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Classes="muted" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Grid.Row="4" Background="#0C1828" CornerRadius="18" Padding="18" BorderBrush="#213854" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Operator" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding OperatorName}" Foreground="#EEF4FF" />
                            <TextBlock Text="The desktop app runs the embedded PowerShell module and keeps credentials in memory only." TextWrapping="Wrap" Classes="muted" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
            <Border Classes="heroCard" Margin="0,0,0,20">
                <Grid ColumnDefinitions="1.6*,0.95*" ColumnSpacing="18">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="eyebrow" Text="{Binding SectionLabel}" />
                        <TextBlock Classes="pageTitle" Text="{Binding SectionHeadline}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SectionDescription}" TextWrapping="Wrap" FontSize="16" Foreground="#CFE3FF" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Classes="badge">
                                <TextBlock Classes="badgeText" Text="Desktop App" />
                            </Border>
                            <Border Classes="badge">
                                <TextBlock Classes="badgeText" Text="Self-contained" />
                            </Border>
                            <Border Classes="badge">
                                <TextBlock Classes="badgeText" Text="MSI Ready" />
                            </Border>
                            <Border Classes="badge">
                                <TextBlock Classes="badgeText" Text="{Binding ContextBadge}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#67E8F9" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <Border Classes="chromeCard">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="Workspace Pulse" />
                                <TextBlock Text="{Binding WorkspacePulse}" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ContextDetail}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="secondaryAction" Command="{Binding DisconnectCommand}" Content="Disconnect" />
                            <Button Classes="primaryAction" Command="{Binding ConnectCommand}" Content="{Binding PrimaryActionLabel}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="1.5*,1*" ColumnSpacing="20" Margin="0,0,0,20">
                <Border Classes="surface">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionTitle" Text="Connection Workspace" />
                            <TextBlock Text="A guided operator panel for connection context, credentials, and live module workflows." Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Environment" FontWeight="SemiBold" Foreground="White" />
                                <ComboBox SelectedItem="{Binding Environment}">
                                    <x:String>Commercial</x:String>
                                    <x:String>Government</x:String>
                                    <x:String>Aos2</x:String>
                                    <x:String>FedRAMP</x:String>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Tenant or Partner Label" FontWeight="SemiBold" Foreground="White" />
                                <TextBox Text="{Binding TenantLabel}" Watermark="Contoso MSP" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Client ID" FontWeight="SemiBold" Foreground="White" />
                                <TextBox Text="{Binding ClientId}" Watermark="App registration client ID" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Client Secret" FontWeight="SemiBold" Foreground="White" />
                                <TextBox Text="{Binding ClientSecret}" PasswordChar="●" Watermark="Stored in memory only" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Scope Bundles" FontWeight="SemiBold" Foreground="White" />
                            <TextBox Text="{Binding SelectedBundleSummary}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="secondaryAction" Command="{Binding LoadCustomersCommand}" Content="Load Customers" />
                            <Button Classes="secondaryAction" Command="{Binding LoadCustomerSummaryCommand}" Content="Load Summary" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="surface">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionTitle" Text="Live Context" />
                            <TextBlock Text="Current desktop operator context from the active workflow." Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="10">
                            <TextBlock Text="Selected customer" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding SelectedCustomer}" FontSize="22" Foreground="White" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="10">
                            <TextBlock Text="Selected tenant" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding SelectedTenant}" FontSize="18" Foreground="#D7E7FF" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="The desktop app reconnects with the in-memory profile for each live workflow so operators do not need to rebuild headers, auth, or pagination logic." TextWrapping="Wrap" Classes="muted" />
                        <Button Classes="secondaryAction" Command="{Binding RefreshDependenciesCommand}" Content="Run Preflight Check" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="1.45*,1*" ColumnSpacing="20">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Border Classes="surface" Margin="0,0,0,20">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="sectionTitle" Text="Platform Snapshot" />
                                <TextBlock Text="A cleaner desktop summary surface for high-signal operational status." Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding MetricCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MetricCard">
                                        <Border Width="240" Margin="0,0,14,14" CornerRadius="20" Padding="18" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <Border Height="6" CornerRadius="999" Background="{Binding AccentHex}" />
                                                <TextBlock Text="{Binding Title}" Foreground="#AAC0D9" />
                                                <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="Bold" Foreground="White" />
                                                <TextBlock Text="{Binding Delta}" Foreground="#67E8F9" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Classes="surface" Margin="0,0,0,20">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="sectionTitle" Text="Recent Customer Context" />
                                    <TextBlock Text="Jump back into live customer work without hunting for IDs again." Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Classes="secondaryAction" Command="{Binding LoadCustomersCommand}" Content="Refresh Live List" />
                            </Grid>
                            <TextBlock Text="No recent customer context yet. Select a customer or load a summary to pin it here." IsVisible="{Binding HasNoRecentCustomers}" Classes="muted" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding HasRecentCustomers}">
                                <ItemsControl ItemsSource="{Binding RecentCustomers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:RecentCustomerItem">
                                            <Border Classes="recentCard" Margin="0,0,12,0">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Organization}" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                                                    <TextBlock Text="{Binding OwnerEmail}" Foreground="#D7E7FF" />
                                                    <TextBlock Text="{Binding TenantNames}" TextWrapping="Wrap" Classes="muted" MaxWidth="260" />
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Border Classes="badge">
                                                            <TextBlock Classes="badgeText" Text="{Binding TenantCount}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding LastAccessedLabel}" Classes="muted" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Button Classes="secondaryAction"
                                                            Command="{Binding $parent[Window].DataContext.SelectRecentCustomerCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Content="Open Context"
                                                            HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Classes="surface" Margin="0,0,0,20" IsVisible="{Binding IsOverviewSelected}">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="sectionTitle" Text="Quick Start Workflows" />
                            <ItemsControl ItemsSource="{Binding WorkflowItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkflowItem">
                                        <Border Margin="0,0,0,12" Padding="18" CornerRadius="18" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted" />
                                                    <TextBlock Text="{Binding ScopeBundle}" Foreground="#67E8F9" />
                                                </StackPanel>
                                                <Button Classes="secondaryAction"
                                                        Command="{Binding $parent[Window].DataContext.OpenWorkflowCommand}"
                                                        CommandParameter="{Binding Title}"
                                                        Content="Open"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Classes="surface" IsVisible="{Binding IsCustomersSelected}">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <TextBox Text="{Binding SearchText}" Watermark="Search loaded customers by org, email, or tenant" />
                                <Button Classes="secondaryAction" Command="{Binding ApplySearchCommand}" Content="Select" />
                                <Button Classes="primaryAction" Command="{Binding LoadCustomersCommand}" Content="Refresh" />
                            </Grid>
                            <TextBlock Classes="sectionTitle" Text="Customer Workspace" />
                            <TextBlock Text="Load real partner customers into the app, then choose one for drill-down work." TextWrapping="Wrap" Classes="muted" />
                            <TextBlock Text="No customers loaded yet." IsVisible="{Binding HasNoCustomers}" Classes="muted" />
                            <ScrollViewer MaxHeight="380">
                                <ItemsControl ItemsSource="{Binding Customers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CustomerRecord">
                                            <Border Margin="0,0,0,12" Padding="18" CornerRadius="18" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{Binding Organization}" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                                                        <TextBlock Text="{Binding OwnerEmail}" Foreground="#D7E7FF" />
                                                        <TextBlock Text="{Binding TenantNames}" TextWrapping="Wrap" Classes="muted" />
                                                        <TextBlock Text="{Binding JobStatusName}" Foreground="#67E8F9" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TenantCount}" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="White" />
                                                        <Button Classes="secondaryAction"
                                                                Command="{Binding $parent[Window].DataContext.SelectCustomerCommand}"
                                                                CommandParameter="{Binding .}"
                                                                Content="Select" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Classes="surface" IsVisible="{Binding IsOperationsSelected}">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="sectionTitle" Text="Operations Workspace" />
                            <TextBlock Text="This desktop layer is now wired for live module execution. Customer workflows are active first, with broader backup, baseline, and risk workflows next." TextWrapping="Wrap" Classes="muted" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="secondaryAction" Command="{Binding GenerateReportCommand}" CommandParameter="Backup Posture Summary" Content="Backup Summary" />
                                <Button Classes="secondaryAction" Command="{Binding GenerateReportCommand}" CommandParameter="Baseline Drift Summary" Content="Baseline Summary" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Classes="surface" IsVisible="{Binding IsReportsSelected}">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="sectionTitle" Text="Customer Summary" />
                            <TextBlock Text="{Binding SummaryHeadline}" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SummaryDetail}" TextWrapping="Wrap" Classes="muted" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding HasCustomerSummary}">
                                <Border CornerRadius="16" Padding="16" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Services" Foreground="#AAC0D9" />
                                        <TextBlock Text="{Binding CurrentCustomerSummary.ServiceNames}" TextWrapping="Wrap" Foreground="White" />
                                        <TextBlock Text="{Binding CurrentCustomerSummary.ProductCount}" FontSize="28" FontWeight="Bold" Foreground="#67E8F9" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="16" Padding="16" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Backup Coverage" Foreground="#AAC0D9" />
                                        <TextBlock Text="{Binding CurrentCustomerSummary.BackupModuleCount}" FontSize="28" FontWeight="Bold" Foreground="#67E8F9" />
                                        <TextBlock Text="{Binding CurrentCustomerSummary.TenantNames}" TextWrapping="Wrap" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Button Classes="primaryAction" Command="{Binding LoadCustomerSummaryCommand}" Content="Refresh Summary" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="20">
                    <Border Classes="surface">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="sectionTitle" Text="Desktop Readiness" />
                                <Button Classes="secondaryAction" Command="{Binding RefreshDependenciesCommand}" Content="Refresh" HorizontalAlignment="Left" />
                            </StackPanel>
                            <TextBlock Text="{Binding DependencySummary}" TextWrapping="Wrap" Classes="muted" />
                            <ItemsControl ItemsSource="{Binding DependencyChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DependencyCheckItem">
                                        <Border Margin="0,0,0,10" Padding="14" CornerRadius="14" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Status}" Foreground="#67E8F9" />
                                                </Grid>
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Classes="surface">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="sectionTitle" Text="Recent Activity" />
                            <ScrollViewer MaxHeight="520">
                                <ItemsControl ItemsSource="{Binding ActivityItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ActivityItem">
                                            <Border Margin="0,0,0,12" Padding="16" CornerRadius="16" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" />
                                                        <Border Padding="10,4" CornerRadius="999" Background="#1C3553">
                                                            <TextBlock Text="{Binding Status}" Foreground="#67E8F9" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted" />
                                                    <TextBlock Text="{Binding Timestamp}" Foreground="#8CA4BF" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            </Grid>
        </Grid>

        <Border IsVisible="{Binding IsBusy}"
            Background="#AA050A12"
            ZIndex="100">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Border.Transitions>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <Border Classes="glassPanel">
                    <StackPanel Spacing="18">
                        <TextBlock Text="{Binding BusyTitle}" FontSize="26" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding BusyDetail}" TextWrapping="Wrap" Classes="muted" />
                        <ProgressBar IsIndeterminate="True" Height="10" />
                        <TextBlock Text="Please wait while the desktop workspace completes the current action." Classes="muted" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border IsVisible="{Binding IsSplashVisible}"
                Background="#EE07111F"
                ZIndex="110">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
                </Transitions>
            </Border.Transitions>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                <Border Classes="glassPanel">
                    <StackPanel Spacing="20">
                        <Border Width="88" Height="88" CornerRadius="24" Background="#D7263D" HorizontalAlignment="Left">
                            <TextBlock Text="ES" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Elements Shell Desktop" FontSize="38" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{Binding SplashMessage}" FontSize="16" Foreground="#CFE3FF" TextWrapping="Wrap" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="8" />
                        <TextBlock Text="Secure desktop application layer for AvePoint Elements MSP operations." Classes="muted" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border IsVisible="{Binding IsOnboardingVisible}"
            Background="#D9050A12"
            ZIndex="90">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Border.Transitions>
            <Grid Margin="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Classes="heroCard" Margin="0,0,18,0">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Welcome to Elements Shell Desktop" FontSize="36" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{Binding WelcomeHeadline}" FontSize="17" Foreground="#CFE3FF" />
                            <TextBlock Text="{Binding WelcomeDetail}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Classes="stepCard">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{Binding OnboardingProgressLabel}" Foreground="#67E8F9" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CurrentOnboardingStep.Number}" Foreground="#8CA4BF" />
                                </Grid>
                                <ProgressBar Value="{Binding OnboardingProgressValue}" Maximum="100" Height="8" />
                                <TextBlock Text="{Binding CurrentOnboardingStep.Title}" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="{Binding CurrentOnboardingStep.Detail}" TextWrapping="Wrap" Classes="muted" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding OnboardingSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:OnboardingStep">
                                    <Border Classes="stepCard" Width="180">
                                        <StackPanel Spacing="8">
                                            <Border Width="42" Height="42" CornerRadius="14" Background="#0F7BFF">
                                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" MaxHeight="72" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="primaryAction" Command="{Binding AdvanceOnboardingCommand}" Content="{Binding OnboardingPrimaryActionLabel}" />
                            <Button Classes="secondaryAction" Command="{Binding RewindOnboardingCommand}" Content="{Binding OnboardingSecondaryActionLabel}" />
                            <Button Classes="secondaryAction" Command="{Binding RefreshDependenciesCommand}" Content="Check Readiness" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="glassPanel">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Why this feels different" FontSize="24" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="The desktop app gives you a calmer entry point into the platform: fewer raw identifiers, clearer workflow transitions, and shaped output around operator intent." TextWrapping="Wrap" Classes="muted" />

                        <Border Classes="stepCard">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Product principles" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Clean and simple" Foreground="#CFE3FF" />
                                <TextBlock Text="Bundle-aware and secure" Foreground="#CFE3FF" />
                                <TextBlock Text="Operational, not documentation-driven" Foreground="#CFE3FF" />
                                <TextBlock Text="Installer-ready and desktop-native" Foreground="#CFE3FF" />
                            </StackPanel>
                        </Border>

                        <Border Classes="stepCard">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Current highlights" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Hosted PowerShell engine" Classes="muted" />
                                <TextBlock Text="Desktop readiness checks" Classes="muted" />
                                <TextBlock Text="Live customer and summary flows" Classes="muted" />
                                <TextBlock Text="MSI packaging path" Classes="muted" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
