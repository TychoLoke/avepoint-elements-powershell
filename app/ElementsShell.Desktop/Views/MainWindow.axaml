<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ElementsShell.Desktop.ViewModels"
        xmlns:models="using:ElementsShell.Desktop.Models"
        xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1540" d:DesignHeight="960"
        x:Class="ElementsShell.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1540"
        Height="960"
        MinWidth="1280"
        MinHeight="820"
        Background="#07111F"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.surface">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#13233A" Offset="0" />
                    <GradientStop Color="#0D1728" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.sidebarPanel">
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0B1E36" Offset="0" />
                    <GradientStop Color="#091421" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#12243B" />
            <Setter Property="Foreground" Value="#EEF4FF" />
            <Setter Property="BorderBrush" Value="#223A59" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Button.primaryAction">
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0F7BFF" />
            <Setter Property="BorderBrush" Value="#0F7BFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.secondaryAction">
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Foreground" Value="#EEF4FF" />
            <Setter Property="Background" Value="#1A2E49" />
            <Setter Property="BorderBrush" Value="#2A486F" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9CB2CB" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#143052" />
        </Style>
        <Style Selector="TextBlock.badgeText">
            <Setter Property="Foreground" Value="#8FD3FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.glassPanel">
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Background" Value="#E6101824" />
            <Setter Property="BorderBrush" Value="#27405D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="28" />
        </Style>
        <Style Selector="Border.stepCard">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#0C1828" />
            <Setter Property="BorderBrush" Value="#213854" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="Border.heroCard">
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="BorderBrush" Value="#30557E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="26" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#122945" Offset="0" />
                    <GradientStop Color="#0C1828" Offset="0.65" />
                    <GradientStop Color="#12111A" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.recentCard">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#0C1828" />
            <Setter Property="BorderBrush" Value="#213854" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinWidth" Value="220" />
        </Style>
        <Style Selector="Border.chromeCard">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="#101C2D" />
            <Setter Property="BorderBrush" Value="#244668" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.formCard">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="#0F1B2D" />
            <Setter Property="BorderBrush" Value="#27405D" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.brandCard">
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D7263D" Offset="0" />
                    <GradientStop Color="#9B1638" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.miniPanel">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="#0C1828" />
            <Setter Property="BorderBrush" Value="#213854" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.dashboardActionCard">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="#0D1727" />
            <Setter Property="BorderBrush" Value="#244668" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.customerBigCard">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="#0C1828" />
            <Setter Property="BorderBrush" Value="#213854" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.tenantChip">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#143052" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="#67E8F9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid>
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="460" Height="460" Canvas.Left="-140" Canvas.Top="-110" Fill="#1B0F7BFF" />
            <Ellipse Width="360" Height="360" Canvas.Right="80" Canvas.Top="70" Fill="#15D7263D" />
            <Ellipse Width="320" Height="320" Canvas.Right="260" Canvas.Bottom="-120" Fill="#150FB884" />
        </Canvas>
        <Grid Margin="22" IsVisible="{Binding NeedsConnection}">
            <Grid ColumnDefinitions="1.05*,0.95*" ColumnSpacing="22">
                <Border Classes="heroCard">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="22">
                        <StackPanel Spacing="16">
                            <Border Classes="brandCard" HorizontalAlignment="Left">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border CornerRadius="18" Padding="14" Background="#FFFFFF18" Width="82">
                                        <TextBlock Text="ES" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Elements Shell" FontSize="26" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="Desktop edition" Foreground="#FFE8EC" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="Desktop Workspace" />
                                <TextBlock Classes="pageTitle" Text="Operate AvePoint Elements like a real product" TextWrapping="Wrap" />
                                <TextBlock Text="A dedicated desktop workspace for MSP operations, designed to replace raw REST calls, copied identifiers, and fragile scripts with a calmer, guided workflow." TextWrapping="Wrap" Foreground="#CFE3FF" FontSize="16" />
                                <TextBlock Text="{Binding AppVersion}" Classes="muted" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Classes="miniPanel">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="Runtime Status" />
                                    <TextBlock Text="{Binding ReadinessHeadline}" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding DependencySummary}" Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="miniPanel">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="eyebrow" Text="Why This Exists" />
                                    <TextBlock Text="Connect once" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Text="Work from shaped customer context, not API payloads." Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="Keep the PowerShell module underneath, but make the experience feel application-grade." Classes="muted" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2" Spacing="16">
                            <Border Classes="stepCard">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding OnboardingProgressLabel}" Foreground="#67E8F9" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrentOnboardingStep.Number}" Foreground="#8CA4BF" />
                                    </Grid>
                                    <ProgressBar Value="{Binding OnboardingProgressValue}" Maximum="100" Height="8" />
                                    <TextBlock Text="{Binding OnboardingStudioHeadline}" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding OnboardingStudioDetail}" TextWrapping="Wrap" Classes="muted" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding OnboardingSteps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:OnboardingStep">
                                        <Border Classes="stepCard" Width="180">
                                            <StackPanel Spacing="8">
                                                <Border Width="42" Height="42" CornerRadius="14" Background="#0F7BFF">
                                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" MaxHeight="72" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="glassPanel">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="eyebrow" Text="Secure Setup" />
                            <TextBlock Text="{Binding OnboardingConnectionHeadline}" FontSize="28" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{Binding OnboardingConnectionDetail}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Classes="formCard">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Environment" FontWeight="SemiBold" Foreground="White" />
                                    <ComboBox SelectedItem="{Binding Environment}">
                                        <x:String>Commercial</x:String>
                                        <x:String>Government</x:String>
                                        <x:String>Aos2</x:String>
                                        <x:String>FedRAMP</x:String>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Tenant or Partner Label" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox Text="{Binding TenantLabel}" Watermark="Contoso MSP" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Client ID" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox Text="{Binding ClientId}" Watermark="Elements portal application client ID" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Client Secret" FontWeight="SemiBold" Foreground="White" />
                                    <TextBox Text="{Binding ClientSecret}" PasswordChar="●" Watermark="Elements portal application client secret" />
                                </StackPanel>
                                <Button Classes="primaryAction"
                                        Command="{Binding ConnectFromOnboardingCommand}"
                                        Content="{Binding OnboardingConnectionButtonLabel}"
                                        IsEnabled="{Binding CanConnectFromOnboarding}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="miniPanel">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="Portal Guidance" />
                                <TextBlock Text="Use the app registration from your AvePoint Elements portal." FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Credentials stay in memory only for the active desktop session." Classes="muted" />
                                <TextBlock Text="After connection, the app switches into the full operational workspace." Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Margin="22" IsVisible="{Binding IsConnected}">
            <Grid ColumnDefinitions="340,*">
                <Border Classes="sidebarPanel" Margin="0,0,20,0">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <StackPanel Spacing="10">
                            <Border Classes="brandCard">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border CornerRadius="18" Padding="14" Background="#FFFFFF18" Width="82">
                                        <TextBlock Text="ES" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Elements Shell" FontSize="24" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="Connected workspace" Foreground="#FFE8EC" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SectionDescription}" TextWrapping="Wrap" Classes="muted" />
                                <TextBlock Text="{Binding AppVersion}" Classes="muted" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Margin="0,26,0,20" Classes="miniPanel">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="Session" />
                                <TextBlock Text="{Binding ConnectionBadge}" Foreground="#67E8F9" FontWeight="Bold" />
                                <TextBlock Text="{Binding SessionDescriptor}" Foreground="#EEF4FF" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="secondaryAction" Command="{Binding $parent[Window].DataContext.SelectSectionCommand}" CommandParameter="Overview" Content="Home" />
                                    <Button Classes="secondaryAction" Command="{Binding DisconnectCommand}" Content="Disconnect" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Spacing="10">
                            <ItemsControl ItemsSource="{Binding NavigationItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:NavigationItem">
                                        <Button Classes="nav"
                                                Margin="0,0,0,10"
                                                Command="{Binding $parent[Window].DataContext.SelectSectionCommand}"
                                                CommandParameter="{Binding Title}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="44" Height="44" CornerRadius="14" Background="#0F7BFF">
                                                    <TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Subtitle}" Classes="muted" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Grid.Row="4" Classes="miniPanel">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="eyebrow" Text="Operator" />
                                <TextBlock Text="{Binding OperatorName}" Foreground="#EEF4FF" />
                                <TextBlock Text="The desktop app runs the embedded PowerShell module and keeps credentials in memory only." TextWrapping="Wrap" Classes="muted" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                    <Border Classes="heroCard" Margin="0,0,0,20">
                        <Grid ColumnDefinitions="1.6*,0.95*" ColumnSpacing="18">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="eyebrow" Text="{Binding SectionLabel}" />
                                <TextBlock Classes="pageTitle" Text="{Binding SectionHeadline}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SectionDescription}" TextWrapping="Wrap" FontSize="16" Foreground="#CFE3FF" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Classes="badge"><TextBlock Classes="badgeText" Text="Desktop App" /></Border>
                                    <Border Classes="badge"><TextBlock Classes="badgeText" Text="Connected" /></Border>
                                    <Border Classes="badge"><TextBlock Classes="badgeText" Text="{Binding ContextBadge}" /></Border>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#67E8F9" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="12">
                                <Border Classes="chromeCard">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="eyebrow" Text="Workspace Pulse" />
                                        <TextBlock Text="{Binding WorkspacePulse}" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ContextDetail}" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Classes="secondaryAction" Command="{Binding LoadCustomersCommand}" Content="Load Customers" />
                                    <Button Classes="primaryAction" Command="{Binding LoadCustomerSummaryCommand}" Content="Open Summary" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="1.2*,1*" ColumnSpacing="20" Margin="0,0,0,20">
                        <Border Classes="surface">
                            <StackPanel Spacing="16">
                                <TextBlock Classes="sectionTitle" Text="Recent Customer Context" />
                                <TextBlock Text="Reopen live customer work without hunting for identifiers." Classes="muted" TextWrapping="Wrap" />
                                <TextBlock Text="No recent customer context yet. Load customers and open a customer summary to pin context here." IsVisible="{Binding HasNoRecentCustomers}" Classes="muted" />
                                <ScrollViewer MaxHeight="250" IsVisible="{Binding HasRecentCustomers}">
                                    <ItemsControl ItemsSource="{Binding RecentCustomers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:RecentCustomerItem">
                                                <Border Classes="recentCard" Margin="0,0,0,12">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding Organization}" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                                                            <TextBlock Text="{Binding OwnerEmail}" Foreground="#D7E7FF" />
                                                            <TextBlock Text="{Binding TenantNames}" TextWrapping="Wrap" Classes="muted" />
                                                            <TextBlock Text="{Binding LastAccessedLabel}" Classes="muted" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TenantCount}" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="White" />
                                                            <Button Classes="secondaryAction"
                                                                    Command="{Binding $parent[Window].DataContext.SelectRecentCustomerCommand}"
                                                                    CommandParameter="{Binding .}"
                                                                    Content="Open" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="surface">
                            <StackPanel Spacing="16">
                                <TextBlock Classes="sectionTitle" Text="Live Context" />
                                <TextBlock Text="Current selected customer and tenant context for the active workspace." Classes="muted" TextWrapping="Wrap" />
                                <Border Classes="miniPanel">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="eyebrow" Text="Selected Customer" />
                                        <TextBlock Text="{Binding SelectedCustomer}" FontSize="22" Foreground="White" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedTenant}" Foreground="#D7E7FF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="miniPanel">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="eyebrow" Text="Readiness" />
                                        <TextBlock Text="{Binding ReadinessHeadline}" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="{Binding DependencySummary}" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="1.45*,1*" ColumnSpacing="20">
                        <Grid RowDefinitions="Auto,*">
                            <Border Classes="surface" Margin="0,0,0,20" IsVisible="{Binding IsOverviewSelected}">
                                <StackPanel Spacing="18">
                                    <TextBlock Classes="sectionTitle" Text="Home Dashboard" />
                                    <ItemsControl ItemsSource="{Binding MetricCards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MetricCard">
                                                <Border Width="240" Margin="0,0,14,14" CornerRadius="20" Padding="18" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                                    <StackPanel Spacing="10">
                                                        <Border Height="6" CornerRadius="999" Background="{Binding AccentHex}" />
                                                        <TextBlock Text="{Binding Title}" Foreground="#AAC0D9" />
                                                        <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="Bold" Foreground="White" />
                                                        <TextBlock Text="{Binding Delta}" Foreground="#67E8F9" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="sectionTitle" Text="Primary Actions" />
                                    <ItemsControl ItemsSource="{Binding DashboardActions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DashboardActionCard">
                                                <Border Classes="dashboardActionCard" Width="260" Margin="0,0,14,14">
                                                    <StackPanel Spacing="12">
                                                        <Border Height="6" CornerRadius="999" Background="{Binding AccentHex}" />
                                                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted" />
                                                        <Button Classes="secondaryAction"
                                                                Command="{Binding $parent[Window].DataContext.RunDashboardActionCommand}"
                                                                CommandParameter="{Binding CommandParameter}"
                                                                Content="{Binding CommandLabel}"
                                                                HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Classes="surface" IsVisible="{Binding IsCustomersSelected}">
                                <StackPanel Spacing="16">
                                    <Border Classes="heroCard">
                                        <Grid ColumnDefinitions="1.5*,0.9*" ColumnSpacing="18">
                                            <StackPanel Spacing="10">
                                                <TextBlock Classes="eyebrow" Text="Selected Customer" />
                                                <TextBlock Text="{Binding SelectedCustomerHeading}" FontSize="28" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedCustomerMeta}" Foreground="#D7E7FF" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedCustomerStatus}" Classes="muted" TextWrapping="Wrap" />
                                                <WrapPanel IsVisible="{Binding HasSelectedCustomerTenants}">
                                                    <ItemsControl ItemsSource="{Binding SelectedCustomerTenants}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:TenantChip">
                                                                <Border Classes="tenantChip">
                                                                    <TextBlock Classes="badgeText" Text="{Binding Name}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="chromeCard">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Classes="eyebrow" Text="Customer Actions" />
                                                    <Button Classes="secondaryAction" Command="{Binding LoadCustomerSummaryCommand}" Content="Open Summary" />
                                                    <Button Classes="secondaryAction" Command="{Binding GenerateReportCommand}" CommandParameter="Customer Health Snapshot" Content="Open Snapshot" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <TextBox Text="{Binding SearchText}" Watermark="Search loaded customers by org, email, or tenant" />
                                        <Button Classes="secondaryAction" Command="{Binding ApplySearchCommand}" Content="Select" />
                                        <Button Classes="primaryAction" Command="{Binding LoadCustomersCommand}" Content="Refresh" />
                                    </Grid>
                                    <TextBlock Classes="sectionTitle" Text="Customer Workspace" />
                                    <TextBlock Text="Load real partner customers into the app, then choose one for drill-down work." TextWrapping="Wrap" Classes="muted" />
                                    <TextBlock Text="No customers loaded yet." IsVisible="{Binding HasNoCustomers}" Classes="muted" />
                                    <ScrollViewer MaxHeight="430">
                                        <ItemsControl ItemsSource="{Binding Customers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:CustomerRecord">
                                                    <Border Classes="customerBigCard" Margin="0,0,0,14">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                                            <StackPanel Spacing="8">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock Text="{Binding Organization}" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                                                                    <TextBlock Text="{Binding OwnerEmail}" Foreground="#D7E7FF" />
                                                                </StackPanel>
                                                                <WrapPanel Orientation="Horizontal" ItemWidth="150">
                                                                    <Border Classes="badge">
                                                                        <TextBlock Classes="badgeText" Text="{Binding ManagementModeName}" />
                                                                    </Border>
                                                                    <Border Classes="badge">
                                                                        <TextBlock Classes="badgeText" Text="{Binding JobStatusName}" />
                                                                    </Border>
                                                                </WrapPanel>
                                                                <TextBlock Text="{Binding TenantNames}" TextWrapping="Wrap" Classes="muted" />
                                                            </StackPanel>
                                                            <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding TenantCount}" HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" Foreground="White" />
                                                                <TextBlock Text="Tenants" HorizontalAlignment="Center" Classes="muted" />
                                                                <Button Classes="secondaryAction"
                                                                        Command="{Binding $parent[Window].DataContext.SelectCustomerCommand}"
                                                                        CommandParameter="{Binding .}"
                                                                        Content="Open Customer" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Classes="surface" IsVisible="{Binding IsOperationsSelected}">
                                <StackPanel Spacing="16">
                                    <TextBlock Classes="sectionTitle" Text="Operations Workspace" />
                                    <TextBlock Text="Use the desktop shell as a controlled access layer for backup, baseline, and risk flows." TextWrapping="Wrap" Classes="muted" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                        <Border Classes="miniPanel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="eyebrow" Text="Backup" />
                                                <TextBlock Text="Generate backup posture summaries and operational drill-ins." Foreground="White" TextWrapping="Wrap" />
                                                <Button Classes="secondaryAction" Command="{Binding GenerateReportCommand}" CommandParameter="Backup Posture Summary" Content="Open Backup Summary" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Classes="miniPanel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="eyebrow" Text="Baseline" />
                                                <TextBlock Text="Review drift posture and baseline-oriented tenant workflows." Foreground="White" TextWrapping="Wrap" />
                                                <Button Classes="secondaryAction" Command="{Binding GenerateReportCommand}" CommandParameter="Baseline Drift Summary" Content="Open Baseline Summary" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Classes="surface" IsVisible="{Binding IsReportsSelected}">
                                <StackPanel Spacing="16">
                                    <TextBlock Classes="sectionTitle" Text="Customer Summary" />
                                    <TextBlock Text="{Binding SummaryHeadline}" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SummaryDetail}" TextWrapping="Wrap" Classes="muted" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding HasCustomerSummary}">
                                        <Border CornerRadius="16" Padding="16" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Services" Foreground="#AAC0D9" />
                                                <TextBlock Text="{Binding CurrentCustomerSummary.ServiceNames}" TextWrapping="Wrap" Foreground="White" />
                                                <TextBlock Text="{Binding CurrentCustomerSummary.ProductCount}" FontSize="28" FontWeight="Bold" Foreground="#67E8F9" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="16" Padding="16" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Backup Coverage" Foreground="#AAC0D9" />
                                                <TextBlock Text="{Binding CurrentCustomerSummary.BackupModuleCount}" FontSize="28" FontWeight="Bold" Foreground="#67E8F9" />
                                                <TextBlock Text="{Binding CurrentCustomerSummary.TenantNames}" TextWrapping="Wrap" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Button Classes="primaryAction" Command="{Binding LoadCustomerSummaryCommand}" Content="Refresh Summary" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Column="1" Classes="surface">
                            <StackPanel Spacing="16">
                                <TextBlock Classes="sectionTitle" Text="Recent Activity" />
                                <ScrollViewer MaxHeight="620">
                                    <ItemsControl ItemsSource="{Binding ActivityItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ActivityItem">
                                                <Border Margin="0,0,0,12" Padding="16" CornerRadius="16" Background="#0C1828" BorderBrush="#213854" BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" />
                                                            <Border Padding="10,4" CornerRadius="999" Background="#1C3553">
                                                                <TextBlock Text="{Binding Status}" Foreground="#67E8F9" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted" />
                                                        <TextBlock Text="{Binding Timestamp}" Foreground="#8CA4BF" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border IsVisible="{Binding IsBusy}"
            Background="#AA050A12"
            ZIndex="100">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Border.Transitions>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <Border Classes="glassPanel">
                    <StackPanel Spacing="18">
                        <TextBlock Text="{Binding BusyTitle}" FontSize="26" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding BusyDetail}" TextWrapping="Wrap" Classes="muted" />
                        <ProgressBar IsIndeterminate="True" Height="10" />
                        <TextBlock Text="Please wait while the desktop workspace completes the current action." Classes="muted" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border IsVisible="{Binding IsSplashVisible}"
                Background="#EE07111F"
                ZIndex="110">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
                </Transitions>
            </Border.Transitions>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                <Border Classes="glassPanel">
                    <StackPanel Spacing="20">
                        <Border Width="88" Height="88" CornerRadius="24" Background="#D7263D" HorizontalAlignment="Left">
                            <TextBlock Text="ES" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Elements Shell Desktop" FontSize="38" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{Binding SplashMessage}" FontSize="16" Foreground="#CFE3FF" TextWrapping="Wrap" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="8" />
                        <TextBlock Text="Secure desktop application layer for AvePoint Elements MSP operations." Classes="muted" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
